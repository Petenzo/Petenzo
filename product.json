          }
        },
        "share": {
          "type": "share",
          "settings": {}
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "tab_shipping",
        "tab_returns",
        "share"
      ],
      "settings": {}
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Może Ci się spodobać"
      }
    }
