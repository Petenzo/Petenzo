(function(){ const end=new Date(CONFIG.promoKoniec).getTime(), pad=n=>String(n).padStart(2,'0');
  $('#promoDate').textContent=new Date(end).toLocaleString('pl-PL',{day:'numeric',month:'long',hour:'2-digit',minute:'2-digit'});
  const tick=()=>{ let d=Math.max(0,end-Date.now())/1000; 
    $('#tH').textContent=pad(Math.floor(d/3600)); d%=3600; $('#tM').textContent=pad(Math.floor(d/60)); const ts=$('#tS'), v=pad(Math.floor(d%60)); if(ts.textContent!==v){ ts.textContent=v; ts.classList.remove('tick'); void ts.offsetWidth; ts.classList.add('tick'); } };
  tick(); setInterval(tick,1000);
  $('#promoBtn').onclick=()=>$('#bundles').scrollIntoView({behavior:'smooth',block:'center'}); })();
