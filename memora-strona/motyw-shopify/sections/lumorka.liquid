/* ===================================================================== */
const $ = s => document.querySelector(s);
const zl = v => v.toFixed(2).replace('.', ',') + ' zł';
document.querySelectorAll('[data-brand]').forEach(e => e.textContent = CONFIG.marka);
$('#year').textContent = new Date().getFullYear();

function starSvg(fill, size){
  return `<svg viewBox="0 0 24 24" width="${size}" height="${size}"><path d="M12 2.5l2.8 6.4 6.9.6-5.2 4.6 1.6 6.8L12 17.3l-6.1 3.6 1.6-6.8-5.2-4.6 6.9-.6z" fill="${fill?'#f5b50a':'none'}" stroke="#f5b50a" stroke-width="1.5" stroke-linejoin="round"/></svg>`;
}
function renderStars(el){
  const n = +el.dataset.stars, s = +(el.dataset.size||16);
  el.innerHTML = Array.from({length:5},(_,i)=>starSvg(i<Math.round(n),s)).join('');
}
document.querySelectorAll('[data-stars]').forEach(renderStars);

/* ---------- Pasek ogłoszeń ---------- */
const ann = CONFIG.pasekOgloszen.map(t=>`<span><em class="star">✦</em>${t}</span>`).join('');
const aT=$('#announceTrack'); aT.innerHTML=ann;
const aW=aT.scrollWidth||800, aN=Math.max(1,Math.ceil(Math.max(window.innerWidth,screen.width||0,1920)/aW));
const aSet=ann.repeat(aN); aT.innerHTML=aSet+aSet; aT.style.setProperty('--adur',(aN*aW/45)+'s');

/* ---------- Rysowane podglądy (zastępują zdjęcia/filmy, dopóki ich nie wgrasz) ---------- */
function sceneSvg(seed, opts={}){
  let r = seed*9301+49297; const rnd=()=>((r=(r*9301+49297)%233280)/233280);
  const w=400,h=opts.tall?711:432, cx=w/2, cy=opts.cy||h*0.52, R=opts.R||88;
  const bg = opts.bg || ['#1a1410','#2b2017'];
  let lights='';
  for(let i=0;i<70;i++){const x=rnd()*w,y=rnd()*h,s=2+rnd()*9,o=.25+rnd()*.7;
    const col = opts.colorful? ['#ffd27a','#ff6b9a','#7cf2c4','#8fb4ff','#e59bff'][i%5] : '#ffd98a';
    lights+=`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${s.toFixed(1)}" fill="${col}" opacity="${o.toFixed(2)}" filter="url(#b${seed})"/>`;}
  let needles='';
  for(let i=0;i<40;i++){const x=rnd()*w,y=rnd()*h,l=30+rnd()*60,a=rnd()*360;
    needles+=`<ellipse cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" rx="${l.toFixed(0)}" ry="${(l/5).toFixed(0)}" transform="rotate(${a.toFixed(0)} ${x.toFixed(1)} ${y.toFixed(1)})" fill="#e8e2d6" opacity=".09"/>`;}
  const ph = opts.photo || ['#f1c7a8','#7a4b3a','#c98f70'];
  return `<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg${seed}" cx="50%" cy="45%" r="75%"><stop offset="0" stop-color="${bg[1]}"/><stop offset="1" stop-color="${bg[0]}"/></radialGradient>
    <filter id="b${seed}" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.2"/></filter>
    <radialGradient id="glass${seed}" cx="35%" cy="30%" r="75%"><stop offset="0" stop-color="#fff" stop-opacity=".55"/><stop offset=".35" stop-color="#fff" stop-opacity=".05"/><stop offset="1" stop-color="#9fc2ff" stop-opacity=".25"/></radialGradient>
    <linearGradient id="ph${seed}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${ph[0]}"/><stop offset=".55" stop-color="${ph[2]}"/><stop offset="1" stop-color="${ph[1]}"/></linearGradient>
    <clipPath id="c${seed}"><circle cx="${cx}" cy="${cy}" r="${R-6}"/></clipPath>
  </defs>
  <rect width="${w}" height="${h}" fill="url(#bg${seed})"/>
  ${needles}${lights}
  ${opts.strap!==false?`<path d="M${cx-6} 0 L${cx-4} ${cy-R-14} M${cx+6} 0 L${cx+4} ${cy-R-14}" stroke="#c98a6a" stroke-width="5"/><rect x="${cx-8}" y="${cy-R-22}" width="16" height="20" rx="3" fill="#111"/>`:''}
  <circle cx="${cx}" cy="${cy}" r="${R+10}" fill="#9fc2ff" opacity=".18" filter="url(#b${seed})"/>
  <g clip-path="url(#c${seed})">
    <rect x="${cx-R}" y="${cy-R}" width="${R*2}" height="${R*2}" fill="url(#ph${seed})"/>
    <circle cx="${cx-R*.28}" cy="${cy-R*.12}" r="${R*.26}" fill="#f3d3bb"/>
    <path d="M${cx-R*.58} ${cy-R*.18} q${R*.3} -${R*.55} ${R*.6} 0 v${R*.25} h-${R*.6}z" fill="#3b2418"/>
    <circle cx="${cx+R*.3}" cy="${cy+R*.06}" r="${R*.21}" fill="#f6dccb"/>
    <path d="M${cx+R*.08} ${cy-R*.02} q${R*.22} -${R*.4} ${R*.44} 0z" fill="#6b4532"/>
    <rect x="${cx-R*.75}" y="${cy+R*.2}" width="${R*.95}" height="${R*.8}" rx="${R*.3}" fill="#2f3e5c"/>
    <rect x="${cx+R*.05}" y="${cy+R*.3}" width="${R*.55}" height="${R*.7}" rx="${R*.25}" fill="#8db0d8"/>
  </g>
  <circle cx="${cx}" cy="${cy}" r="${R}" fill="url(#glass${seed})" stroke="#e9f1ff" stroke-opacity=".7" stroke-width="3"/>
  <ellipse cx="${cx-R*.38}" cy="${cy-R*.5}" rx="${R*.3}" ry="${R*.12}" transform="rotate(-30 ${cx-R*.38} ${cy-R*.5})" fill="#fff" opacity=".45"/>
  </svg>`;
}
const scenes = [
  {bg:['#14100c','#2a1f16']},
  {bg:['#0d1220','#1f2b45'], colorful:true, photo:['#ffd9e4','#a46a86','#e6a9c0']},
  {bg:['#1b120c','#3a2a1e'], photo:['#cfe3ff','#3c5b8a','#89a9d6']},
  {bg:['#111','#2a2a2a'], strap:false, photo:['#f7e3c4','#8a5a3a','#d6a87f']},
  {bg:['#0f1612','#22342a'], photo:['#e9f3ff','#4f6d96','#a7c0e0']},
  {bg:['#160f17','#33213a'], colorful:true},
  {bg:['#1a1410','#3b2c20'], photo:['#ffe6d1','#a86f4b','#e3ae8a']},
  {bg:['#0c0f17','#1d2436'], photo:['#d6e8ff','#2e4670','#7f9ccc']}
];

/* ---------- Galeria ---------- */
const gTrack = $('#gTrack');
const gItems = CONFIG.zdjecia.length ? CONFIG.zdjecia.map(src=>`<img src="${src}" alt="Lumorka" loading="lazy">`)
                                     : scenes.map((s,i)=>sceneSvg(i+1,s));
gTrack.innerHTML = gItems.map((h,i)=>`<div class="g-slide">${h}${(CONFIG.podpisy||[])[i]?`<div class="g-cap">${CONFIG.podpisy[i]}</div>`:''}</div>`).join('');
const gTotal = gItems.length;
let gIdx = 0;
function gGo(i){ gIdx=(i+gTotal)%gTotal; gTrack.scrollTo({left:gTrack.children[gIdx].offsetLeft-gTrack.children[0].offsetLeft,behavior:'smooth'}); }
gTrack.addEventListener('scroll',()=>{ const w=gTrack.children[0].offsetWidth+10; gIdx=Math.round(gTrack.scrollLeft/w);  [...$('#gThumbs').children].forEach((t,k)=>t.classList.toggle('on',k===gIdx)); },{passive:true});


$('#gThumbs').innerHTML = CONFIG.zdjecia.map((src,k)=>`<button class="${k?'':'on'}" aria-label="Zdjęcie ${k+1}"><img src="${src}" alt=""></button>`).join('');
[...$('#gThumbs').children].forEach((t,k)=>t.onclick=()=>gGo(k));

$('#sbThumb').innerHTML = CONFIG.zdjecia[0] ? `<img src="${CONFIG.zdjecia[0]}" alt="">` : sceneSvg(99,{R:110});

/* ---------- Pakiety (z wyborem koloru dla każdej sztuki) ---------- */
let color='Biały', chosen=1;
const unitColors=CONFIG.pakiety.map((_,i)=>Array(i+1).fill('Biały'));
const COLORS=[['Biały','#ffffff'],['Czarny','#1b1b1f']];
function renderBundles(){
  $('#bundles').innerHTML = CONFIG.pakiety.map((p,i)=>{
    const save = p.stara ? `<span class="save-pill">Oszczędzasz ${zl(p.stara-p.cena)}</span> + darmowa dostawa` : '<span class="save-pill">Darmowa dostawa</span>';
    const names=['1 Lumorka','Zestaw 2 Lumorek','Zestaw 3 Lumorek'], subs=['Idealna na prezent','Dla Ciebie i bliskiej osoby','Dla całej rodziny'];
    return `<div class="bundle${i===chosen?' active':''}" data-i="${i}">
      ${p.badge?`<span class="badge">${p.badge}</span>`:''}
      <div class="b-main"><span class="radio"></span><img class="b-thumb" src="${CONFIG.zdjecia[i]||CONFIG.zdjecia[0]}" alt="">
        <div><div class="b-name">${names[i]||(i+1)+' szt.'}</div><div class="b-sub">${subs[i]||''}</div><div class="b-save">${save}</div></div>
        <div class="b-price">${zl(p.cena)}${p.stara?`<s class="b-old">${zl(p.stara)}</s>`:''}</div></div>
      <div class="b-opts">${unitColors[i].map((c,k)=>`<div class="unit"><span class="unit-l">Sztuka ${k+1}: <b>${c}</b></span><span class="sw-row">${COLORS.map(([n,h])=>`<button class="sw${n===c?' on':''}" data-u="${i}-${k}" data-c="${n}" style="--c:${h}" aria-label="${n}"></button>`).join('')}</span></div>`).join('')}
        ${p.prezenty.length?`<div class="b-gifts">🎁 Gratis: podstawka, zawieszka i ściereczka</div>`:''}</div>
    </div>`;}).join('');
  const p=CONFIG.pakiety[chosen];
  $('#heroPrice').textContent=zl(p.cena); $('#heroOld').textContent=p.stara?zl(p.stara):''; $('#heroOff').textContent=p.stara?`−${Math.round((1-p.cena/p.stara)*100)}%`:''; $('#heroOff').style.display=p.stara?'':'none';
  $('#ctaPrice').textContent=zl(p.cena); $('#sbPrice').textContent=zl(p.cena);
}
$('#bundles').addEventListener('click',e=>{
  const sw=e.target.closest('.sw'); if(sw){ const [i,k]=sw.dataset.u.split('-').map(Number); unitColors[i][k]=sw.dataset.c; chosen=i; renderBundles(); return; }
  const b=e.target.closest('.bundle'); if(b){ chosen=+b.dataset.i; renderBundles(); }
});
renderBundles();

/* ---------- Koszyk (demo) ---------- */
let cart = 0;
function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove('show'),2400); }
let cartItems=[], shipMethod='InPost Paczkomat';
const brandName=n=>n.replace('Lumorka',CONFIG.marka);
function cartQty(){ return cartItems.reduce((a,i)=>a+i.qty,0); }
function cartTotals(){ let sum=0, old=0; cartItems.forEach(i=>{const p=CONFIG.pakiety[i.p]; sum+=p.cena*i.qty; old+=(p.stara||p.cena)*i.qty;}); return {sum, save:old-sum, old}; }
function unitsInCart(){ return cartItems.reduce((a,i)=>a+(i.p+1)*i.qty,0); }
function itemHtml(i,k){ const p=CONFIG.pakiety[i.p], old=(p.stara||p.cena)*i.qty, now=p.cena*i.qty;
  return `<div class="ci2"><img src="${CONFIG.zdjecia[i.p]||CONFIG.zdjecia[0]}" alt=""><div class="ci2-main"><div class="ci2-top"><div><div class="ci-name">${brandName(p.nazwa)}</div><div class="ci-sub">Kolor: ${i.color}</div></div><button class="ci2-del" data-del="${k}" aria-label="Usuń">🗑️</button></div>
  <div class="ci2-bot"><span class="qty"><button data-k="${k}" data-d="-1" aria-label="Mniej">−</button><span>${i.qty}</span><button data-k="${k}" data-d="1" aria-label="Więcej">+</button></span>
  <div class="ci2-price">${p.stara?`<s>${zl(old)}</s> `:''}<b>${zl(now)}</b>${p.stara?`<em>Oszczędzasz ${zl(old-now)}</em>`:''}</div></div></div></div>`; }
function sumHtml(){ const t=cartTotals();
  return `${t.save>0?`<div class="sum2 save"><span>Łączny rabat</span><span>−${zl(t.save)}</span></div>`:''}<div class="sum2 total"><span>Łączna kwota</span><span>${zl(t.sum)}</span></div><div class="sum2 ship"><span>Dostawa</span><span>Wybierzesz w następnym kroku</span></div>`; }
const PAYROW='<div class="pay-row"><span class="pi blik">blik</span><span class="pi visa">VISA</span><span class="pi mc"><i></i><i></i>mastercard</span><span class="pi ap"><svg viewBox="0 0 384 512" width="13" height="16" fill="#fff" aria-hidden="true"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>Pay</span><span class="pi gp"><svg viewBox="0 0 48 48" width="16" height="16" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>Pay</span><span class="pi p24">P24</span></div>';
function renderCart(){
  const n=cartQty(), c=$('#cartCount'); c.textContent=n; c.style.display=n?'grid':'none'; $('#drCount').textContent=n;
  const u=unitsInCart(), ub=$('#upsellBar');
  if(u>0 && u<3){ const next=CONFIG.pakiety[u]; ub.innerHTML=`Dodaj jeszcze <b>1 kulę</b> i zapłać tylko <b>${zl(next.cena/(u+1))}</b> za sztukę<div class="ub-track"><i style="width:${u/3*100}%"></i></div>`; ub.style.display='block'; } else ub.style.display='none';
  if(!cartItems.length){ $('#drItems').innerHTML='<div class="dr-empty">Twój koszyk jest pusty<br><button class="btn btn-primary" id="drShop">Wróć do sklepu</button></div>'; $('#drFoot').innerHTML=''; const b=$('#drShop'); if(b) b.onclick=closeCart; }
  else { $('#drItems').innerHTML=cartItems.map(itemHtml).join(''); $('#drFoot').innerHTML=sumHtml()+'<button class="btn cta-big" id="drCheckout">Realizuj zakup</button>'+PAYROW; $('#drCheckout').onclick=()=>openShip(); }
  if($('#cpItems')){ $('#cpItems').innerHTML=cartItems.length?cartItems.map(itemHtml).join(''):'<div class="dr-empty">Koszyk jest pusty.</div>'; $('#cpSum').innerHTML=sumHtml(); }
}
document.addEventListener('click',e=>{ const q=e.target.closest('[data-d]'); if(q){ const i=cartItems[+q.dataset.k]; i.qty=Math.max(1,i.qty+ +q.dataset.d); renderCart(); }
  const d=e.target.closest('[data-del]'); if(d){ cartItems.splice(+d.dataset.del,1); renderCart(); } });
function openCart(){ renderCart(); $('#drawer').classList.add('open'); $('#overlay').classList.add('open'); }
function closeCart(){ $('#drawer').classList.remove('open'); $('#overlay').classList.remove('open'); }
function openShip(){ $('#shipModal').classList.add('open'); $('#overlay').classList.add('open'); }
function closeShip(){ $('#shipModal').classList.remove('open'); if(!$('#drawer').classList.contains('open')) $('#overlay').classList.remove('open'); }
$('#cartBtn').onclick=openCart; $('#drClose').onclick=closeCart; $('#overlay').onclick=()=>{closeCart();closeShip();}; $('#shipClose').onclick=closeShip;
document.querySelectorAll('.ship-opt').forEach(b=>b.onclick=()=>{ document.querySelectorAll('.ship-opt').forEach(x=>x.classList.toggle('on',x===b)); shipMethod=b.dataset.ship; });
async function goCheckout(){ const V={"Biały": 55770552336725, "Czarny": 55770552369493}, m={}; cartItems.forEach(i=>i.color.split(', ').forEach(c=>{const v=V[c]||V['Biały']; m[v]=(m[v]||0)+i.qty;})); try{ await fetch('/cart/clear.js',{method:'POST'}); const r=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:Object.entries(m).map(([id,quantity])=>({id:+id,quantity}))})}); if(!r.ok) throw 0; location.href='/checkout'; }catch(e){ toast('Coś poszło nie tak, spróbuj ponownie.'); } }
$('#shipGo').onclick=()=>{ $('#shipGo').textContent='Przechodzę do kasy…'; goCheckout(); };
function addToCart(){
  const col=unitColors[chosen].join(', ');
  const ex=cartItems.find(i=>i.p===chosen&&i.color===col); if(ex) ex.qty++; else cartItems.push({p:chosen,color:col,qty:1});
  openCart();
}
$('#addToCart').onclick=addToCart;
$('#sbBtn').onclick=()=>{ $('#bundles').scrollIntoView({behavior:'smooth',block:'center'}); };

const initials = n => `<svg viewBox="0 0 40 40" width="100%" height="100%"><circle cx="20" cy="15" r="7.5" fill="rgba(255,255,255,.92)"/><path d="M6 38c1.5-8.5 7.2-13 14-13s12.5 4.5 14 13z" fill="rgba(255,255,255,.92)"/></svg>`;
/* ---------- Filmy: Zobacz to w akcji ---------- */
const vTrack=$('#vTrack'), vDots=$('#vDots');
const vScenes=[{bg:['#2b2a2e','#4a4650'],strap:false,R:80},{bg:['#14100c','#2a1f16'],R:70},{bg:['#1d1a14','#3d3426'],strap:false,R:80},{bg:['#2a2520','#4a4035'],R:80},{bg:['#0d0b18','#251b3a'],colorful:true,R:70}];
vTrack.innerHTML = CONFIG.filmy.map((f,i)=>`
  <div class="v-card" data-i="${i}">
    ${f.poster?`<img class="v-poster" src="${f.poster}" alt="">`:`<div class="v-ph">${sceneSvg(50+i,{...vScenes[i%vScenes.length],tall:true,cy:420})}</div>`}
    <video playsinline muted loop preload="none"></video>
    <div class="v-caption" style="top:${f.gora||18}%"></div>
    <button class="v-play" aria-label="Odtwórz film"><svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8z"/></svg></button>
  </div>`).join('');
const vDesk=matchMedia('(min-width:900px)').matches, vOff=vDesk?1:0;
vDots.innerHTML = (vDesk?[0,1,2]:CONFIG.filmy).map((_,i)=>`<i class="${i?'':'on'}"></i>`).join('');
const cards=[...vTrack.children];
function capAt(f,t){ let txt=''; (f.napisy||[]).forEach(n=>{ if(t>=n.od) txt=n.tekst; }); return txt; }
// Film ładowany w całości jako blob – działa też w Safari i na hostingach bez obsługi "Range".
const srcCache={};
function loadSrc(i){
  if(srcCache[i]) return srcCache[i];
  const f=CONFIG.filmy[i];
  if(f.plik.startsWith('data:')){
    srcCache[i]=new Promise(res=>{ const bin=atob(f.plik.split(',')[1]), u=new Uint8Array(bin.length);
      for(let k=0;k<bin.length;k++) u[k]=bin.charCodeAt(k);
      res(URL.createObjectURL(new Blob([u],{type:'video/mp4'}))); });
  } else {
    srcCache[i]=fetch(f.plik).then(r=>{ if(!r.ok) throw 0; return r.blob(); })
      .then(b=>URL.createObjectURL(new Blob([b],{type:'video/mp4'}))).catch(()=>f.plik);
  }
  return srcCache[i];
}
function playCard(card, auto){
  const i=+card.dataset.i, v=card.querySelector('video');
  if(!auto) cards.forEach(c=>{ if(c!==card){ c.querySelector('video').pause(); c.classList.remove('playing'); }});
  card.classList.add('loading');
  loadSrc(i).then(src=>{
    if(v.dataset.src!==src){ v.src=src; v.dataset.src=src; }
    return v.play();
  }).then(()=>{ card.classList.add('started'); })
    .catch(()=>{ card.classList.remove('loading','playing','started'); });
}
cards.forEach((card,i)=>{
  const f=CONFIG.filmy[i], v=card.querySelector('video'), cap=card.querySelector('.v-caption');
  cap.textContent=capAt(f,0); cap.style.display=cap.textContent?'block':'none';
  const upd=()=>{ const t=capAt(f,v.currentTime); if(cap.textContent!==t){cap.textContent=t;} cap.style.display=t?'block':'none'; if(!v.paused) requestAnimationFrame(upd); };
  v.addEventListener('play',()=>requestAnimationFrame(upd));
  v.addEventListener('pause',()=>card.classList.remove('playing','started'));
  v.addEventListener('timeupdate',()=>{ if(v.currentTime>0.05 && card.classList.contains('started')){ card.classList.add('playing'); card.classList.remove('loading'); } });
  card.querySelector('.v-play').onclick=()=>playCard(card);
  v.onclick=()=>{ if(v.paused) playCard(card); else { v.pause(); card.dataset.userPaused='1'; } };
});
// każdy film rusza sam, gdy jest widoczny na ekranie
loadSrc(0);
const vio=new IntersectionObserver(es=>es.forEach(en=>{ const c=en.target, v=c.querySelector('video');
  if(en.isIntersecting){ if(!c.dataset.userPaused) playCard(c,true); }
  else if(!v.paused){ v.pause(); } }),{threshold:.5});
cards.forEach(c=>vio.observe(c));
let actionVisible=false;
let vIdx=0;
function vCenter(i){ vIdx=Math.max(0,Math.min(cards.length-1,i)); const c=cards[vIdx]; vTrack.scrollTo({left:c.offsetLeft-(vTrack.clientWidth-c.offsetWidth)/2,behavior:'smooth'}); }
vTrack.addEventListener('scroll',()=>{
  const mid=vTrack.scrollLeft+vTrack.clientWidth/2; let best=0,bd=1e9;
  cards.forEach((c,i)=>{const d=Math.abs(c.offsetLeft+c.offsetWidth/2-mid); if(d<bd){bd=d;best=i;}});
  vIdx=best; [...vDots.children].forEach((d,k)=>d.classList.toggle('on',k===Math.min(vDots.children.length-1,Math.max(0,vIdx-vOff))));
},{passive:true});
const vStepW=()=>cards.length>1?cards[1].offsetLeft-cards[0].offsetLeft:cards[0].offsetWidth;
$('#vPrev').onclick=()=>vTrack.scrollBy({left:-vStepW(),behavior:'smooth'}); $('#vNext').onclick=()=>vTrack.scrollBy({left:vStepW(),behavior:'smooth'});
[...vDots.children].forEach((d,k)=>d.onclick=()=>vCenter(k+vOff));

/* ---------- Fale (animowane) ---------- */
function wavePath(h, amp, phase, waves){
  let d=`M0 ${h}`; const W=1440*2, steps=120;
  for(let i=0;i<=steps;i++){const x=W*i/steps; const y=h*0.55 - amp*Math.sin((i/steps)*Math.PI*2*waves+phase); d+=` L${x.toFixed(1)} ${y.toFixed(1)}`;}
  return d+` L${W} ${h} Z`;
}
document.querySelectorAll('[data-wave]').forEach(w=>{
  const h=60;
  w.innerHTML = `
    <div class="layer back"><svg viewBox="0 0 2880 ${h}" preserveAspectRatio="none"><path d="${wavePath(h,14,1.2,4)}" fill="#e7d6ae"/></svg></div>
    <div class="layer"><svg viewBox="0 0 2880 ${h}" preserveAspectRatio="none"><path d="${wavePath(h+8,10,0,2)}" fill="#1b3a6b" transform="translate(0,6)"/></svg></div>`;
});

