<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<link rel="canonical" href="{{ canonical_url }}">
<meta name="google-site-verification" content="E9s8FqFXQeFQdFco-fwGXVXTbGTXxlWEIoX38WEWwCQ">
<meta name="description" content="Lulavi – miękka opaska z wbudowanymi słuchawkami dla dzieci. Spokój w samolocie, w aucie, w restauracji i w domu.">
<link rel="icon" type="image/png" sizes="48x48" href="https://cdn.shopify.com/s/files/1/1123/3876/4114/files/kot-ikona-48.png">
<link rel="icon" type="image/png" sizes="192x192" href="https://cdn.shopify.com/s/files/1/1123/3876/4114/files/kot-ikona-192.png">
<link rel="apple-touch-icon" href="https://cdn.shopify.com/s/files/1/1123/3876/4114/files/kot-ikona-512.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
<style>
  /* Jasny, przejrzysty sklep: dużo bieli, zdjęcia w roli głównej, koral jako jedyny mocny kolor */
  :root {
    color-scheme: light;
    --ink: #1c2440;
    --text: #2b3350;
    --muted: #66708a;
    --coral: #ff6a3d;
    --coral-dark: #e8532a;
    --peach: #fff1ea;
    --cream: #fffaf6;
    --sky: #eef5ff;
    --line: #ece7e2;
    --green: #17a06a;
    --red: #e04848;
    --star: #ffb020;
    --radius: 20px;
    --shadow: 0 12px 32px rgba(28, 36, 64, .08);
    --display: "Fredoka", "Nunito Sans", system-ui, sans-serif;
    --body: "Nunito Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 84px; }
  body {
    margin: 0;
    font-family: var(--body);
    color: var(--text);
    background: #fff;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 { font-family: var(--display); color: var(--ink); line-height: 1.15; margin: 0; font-weight: 600; text-wrap: balance; }
  p { margin: 0; }
  a { color: inherit; }
  img { max-width: 100%; display: block; }
  .hl { color: var(--coral); }
  .wrap { max-width: 1120px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  section { padding-block: 76px; }
  section.tint { background: var(--cream); }
  section.sky { background: var(--sky); }

  /* ---------- wspólne ---------- */
  .eyebrow {
    display: inline-block;
    font-size: 12.5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 10px;
  }
  .sec-head { text-align: center; max-width: 720px; margin: 0 auto 40px; }
  .sec-head h2 { font-size: clamp(26px, 3.6vw, 38px); }
  .sec-head p { color: var(--muted); margin-top: 10px; font-size: 17px; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%;
    padding: 17px 24px;
    border: 0; border-radius: 999px;
    background: var(--coral);
    color: #fff;
    font-family: var(--body); font-size: 17px; font-weight: 800;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(255, 106, 61, .32);
    transition: transform .15s, background .15s;
  }
  .btn:hover { background: var(--coral-dark); transform: translateY(-1px); }
  .btn:focus-visible, .swatch:focus-visible, .tab:focus-visible, summary:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  .btn.inline { width: auto; }

  .card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .photo { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); background: var(--peach); }

  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ticks li { display: flex; gap: 10px; align-items: flex-start; font-size: 15.5px; }
  .ticks li::before {
    content: "✓";
    flex: 0 0 22px; height: 22px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--peach); color: var(--coral);
    font-size: 12px; font-weight: 800;
    margin-top: 1px;
  }

  /* ---------- pasek + nagłówek ---------- */
  .topbar { background: var(--ink); color: #fff; overflow: hidden; padding-block: 10px; }
  .ticker { display: flex; width: max-content; animation: ticker 30s linear infinite; will-change: transform; backface-visibility: hidden; }
  .ticker span { flex: 0 0 auto; padding: 0 28px; font-size: 13px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
  .ticker span::before { content: "●"; color: var(--coral); margin-right: 14px; font-size: 9px; vertical-align: 2px; }
  @keyframes ticker { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-50%, 0, 0); } }
  @media (prefers-reduced-motion: reduce) { .ticker { animation-duration: 80s; } }

  header.site { background: rgba(255,255,255,.96); border-bottom: 1px solid var(--line); position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10; backdrop-filter: blur(8px); }
  body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 11; background: #fff; }
  header.site .wrap { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .logo { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-family: var(--display); font-weight: 700; font-size: 30px; color: var(--ink); letter-spacing: -.01em; }
  .logo svg { width: 46px; height: 35px; }
  .nav { display: flex; gap: 20px; font-weight: 700; font-size: 14.5px; white-space: nowrap; }
  .nav a { text-decoration: none; color: var(--muted); }
  .nav a:hover { color: var(--ink); }
  .cart { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--peach); text-decoration: none; }
  .cart svg { width: 21px; height: 21px; stroke: var(--ink); }

  /* ---------- HERO ---------- */
  .hero { padding-top: 40px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 40px; align-items: start; }
  .gallery { position: sticky; top: 90px; min-width: 0; }
  .slider-wrap { position: relative; }
  .slider { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; border-radius: var(--radius); scrollbar-width: none; -webkit-overflow-scrolling: touch; background: var(--peach); }
  .slider::-webkit-scrollbar { display: none; }
  .slide { position: relative; flex: 0 0 100%; width: 100%; margin: 0; aspect-ratio: 4 / 3; scroll-snap-align: start; }
  .slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .slide figcaption { position: absolute; left: 14px; bottom: 14px; right: 14px; display: flex; align-items: center; gap: 8px; width: max-content; max-width: calc(100% - 28px); padding: 9px 14px; border-radius: 999px; background: rgba(255,255,255,.94); color: var(--ink); font-weight: 800; font-size: 15px; box-shadow: 0 6px 18px rgba(28,36,64,.18); }
  .slide figcaption span { font-size: 18px; }
  .arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 42px; height: 42px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: var(--ink); font-size: 26px; line-height: 1; cursor: pointer; box-shadow: 0 4px 14px rgba(28,36,64,.18); display: grid; place-items: center; }
  .arrow.prev { left: 12px; } .arrow.next { right: 12px; }
  .thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 14px; }
  .thumb { padding: 0; border: 2px solid transparent; border-radius: 10px; background: none; cursor: pointer; overflow: hidden; }
  .thumb img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .thumb[aria-current="true"] { border-color: var(--coral); }
  .trust { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .trust li { display: grid; grid-template-columns: 36px 1fr; column-gap: 10px; align-items: center; padding: 12px 14px; border-radius: 14px; background: var(--cream); border: 1px solid var(--line); font-size: 13px; color: var(--muted); line-height: 1.35; }
  .trust li span { grid-row: span 2; width: 36px; height: 36px; border-radius: 50%; background: #fff; display: grid; place-items: center; font-size: 17px; }
  .trust li b { color: var(--ink); font-size: 14px; }
  .dots { display: flex; justify-content: center; gap: 7px; margin-top: 12px; }
  .dots button { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 999px; background: #d9d4cf; cursor: pointer; transition: width .2s, background .2s; }
  .dots button[aria-current="true"] { width: 22px; background: var(--coral); }

  .buy { min-width: 0; }
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; background: var(--peach); color: var(--coral-dark); font-size: 13px; font-weight: 800; }
  .buy h1 { font-size: clamp(30px, 4.2vw, 46px); margin-top: 14px; }
  .buy .lead { color: var(--muted); font-size: 17px; margin-top: 12px; }
  .rating { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 14px; font-size: 14.5px; color: var(--muted); }
  .rating .stars { color: var(--star); letter-spacing: 1px; font-size: 16px; }
  .price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .price { font-family: var(--display); font-size: 36px; font-weight: 700; color: var(--ink); }
  .old { color: var(--muted); text-decoration: line-through; font-size: 18px; }
  .save { font-size: 13px; font-weight: 800; color: #fff; background: var(--green); padding: 3px 10px; border-radius: 999px; }
  .buy .ticks { margin-top: 20px; }

  .bundle-head { display: flex; align-items: center; gap: 12px; margin: 26px 0 14px; }
  .bundle-head::before, .bundle-head::after { content: ""; flex: 1; height: 1.5px; background: var(--line); }
  .bundle-head span { font-size: 13px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); white-space: nowrap; }
  .offers { display: grid; gap: 12px; }
  .offer { position: relative; display: block; padding: 14px 16px; border: 1.5px solid var(--line); border-radius: 16px; background: #fff; cursor: pointer; transition: border-color .15s, background .15s; }
  .offer:hover { border-color: #ffc6b2; }
  .offer.on { border: 2px solid var(--coral); background: var(--cream); padding: 13.5px 15.5px; }
  .offer input[type="radio"] { position: absolute; opacity: 0; pointer-events: none; }
  .offer-row { display: flex; align-items: center; gap: 12px; }
  .dot { flex: 0 0 20px; height: 20px; border-radius: 50%; border: 2px solid #c9ced9; background: #fff; display: grid; place-items: center; }
  .offer.on .dot { border-color: var(--coral); }
  .offer.on .dot::after { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--coral); }
  .offer input:focus-visible ~ .offer-row .dot { outline: 2px solid var(--ink); outline-offset: 2px; }
  .offer-name { flex: 1; min-width: 0; }
  .offer-name b { display: block; font-size: 16.5px; color: var(--ink); }
  .offer-name small { font-size: 13px; color: var(--muted); }
  .offer-name small.green { color: var(--green); font-weight: 700; }
  .offer-price { text-align: right; font-variant-numeric: tabular-nums; }
  .offer-price b { display: block; font-size: 18px; font-weight: 800; color: var(--ink); }
  .offer-price s { font-size: 13px; color: var(--muted); }
  .offer-badge { position: absolute; top: -11px; right: 14px; padding: 3px 10px; border-radius: 6px; background: var(--ink); color: #fff; font-size: 11.5px; font-weight: 800; }
  .picks { display: none; gap: 10px; margin: 12px 0 2px; }
  .offer.on .picks { display: grid; }
  .pick-label { font-size: 13px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
  .pick-label span { color: var(--coral-dark); }
  .swatches { display: grid; grid-template-columns: repeat(9, minmax(0, 40px)); gap: 6px; }
  .swatch { padding: 0; border: 2px solid var(--line); border-radius: 50%; background: #fff; cursor: pointer; overflow: hidden; aspect-ratio: 1 / 1; transition: border-color .12s, transform .12s; }
  .swatch img { width: 100%; height: 100%; object-fit: cover; }
  .swatch:hover { transform: translateY(-1px); }
  .swatch[aria-checked="true"] { border-color: var(--coral); box-shadow: 0 0 0 2px var(--coral); }

  .guarantee { display: flex; gap: 12px; align-items: center; margin: 18px 0; padding: 13px 15px; border-radius: 14px; background: var(--sky); }
  .guarantee .ico { flex: 0 0 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: #fff; font-size: 20px; }
  .guarantee b { display: block; color: var(--ink); font-size: 15px; }
  .guarantee span { font-size: 13.5px; color: var(--muted); }
  .under-btn { text-align: center; font-size: 13px; color: var(--muted); margin-top: 10px; }

  /* ---------- gdzie się przydaje ---------- */
  .uses { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .use { overflow: hidden; }
  .use img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .use div { padding: 16px 18px 20px; }
  .use h3 { font-size: 20px; }
  .use p { color: var(--muted); font-size: 15px; margin-top: 6px; }

  /* ---------- dwie kolumny ---------- */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .split h2 { font-size: clamp(26px, 3.4vw, 36px); }
  .split .lead { color: var(--muted); margin-top: 10px; font-size: 16.5px; }
  .split .body > .ticks, .split .body > .xlist { margin-top: 22px; }
  .split .body { min-width: 0; }
  .xlist { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .xlist li { display: flex; gap: 10px; align-items: flex-start; padding: 11px 14px; background: #fff; border: 1px solid var(--line); border-radius: 12px; font-size: 15px; }
  .xlist li::before { content: "✕"; flex: 0 0 20px; height: 20px; display: grid; place-items: center; border-radius: 50%; background: #fde8e8; color: var(--red); font-size: 11px; font-weight: 800; margin-top: 1px; }
  .summary { margin-top: 16px; padding: 14px 16px; border-radius: 12px; background: var(--peach); font-weight: 800; color: var(--ink); font-size: 15.5px; }

  /* ---------- kroki ---------- */
  .steps { display: grid; gap: 14px; }
  .step { display: flex; gap: 16px; align-items: flex-start; padding: 20px; }
  .step .num { flex: 0 0 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--coral); color: #fff; font-family: var(--display); font-weight: 700; font-size: 19px; }
  .step p { font-size: 15px; color: var(--muted); }
  .step p b { display: block; font-size: 17px; color: var(--ink); margin-bottom: 2px; }

  /* ---------- 9 wzorów ---------- */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .chip { padding: 7px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-weight: 700; font-size: 14px; color: var(--ink); }

  /* ---------- zestaw ---------- */
  .tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .tab { padding: 9px 20px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; font-family: var(--body); font-size: 14.5px; font-weight: 700; color: var(--muted); cursor: pointer; }
  .tab[aria-selected="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .box { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; padding: 28px; align-items: center; }
  .box h3 { font-size: 22px; }
  .box p { color: var(--muted); margin-top: 8px; }
  .panel-list { background: var(--cream); border-radius: 14px; padding: 20px; }
  .panel-title { font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--coral); margin-bottom: 12px; }

  /* ---------- porównanie ---------- */
  .table-wrap { overflow-x: auto; border-radius: var(--radius); }
  table.cmp { width: 100%; table-layout: fixed; border-collapse: collapse; background: #fff; font-size: 15px; }
  .cmp col.c-name { width: 40%; }
  .cmp th, .cmp td { padding: 15px 12px; text-align: center; border-bottom: 1px solid var(--line); }
  .cmp th { font-weight: 800; color: var(--ink); font-size: 14px; }
  .cmp th:first-child, .cmp td:first-child { text-align: left; font-weight: 600; }
  .cmp tr:last-child td { border-bottom: 0; }
  .cmp .us { background: var(--peach); }
  .cmp th.us { color: var(--coral-dark); font-family: var(--display); font-size: 17px; }
  .yes { color: var(--coral); font-weight: 800; font-size: 18px; }
  .no { color: #c4c9d4; font-weight: 800; font-size: 16px; }

  /* ---------- opinie ---------- */
  .marquee { overflow: hidden; padding-block: 6px 14px; }
  .marquee-track { display: flex; width: max-content; animation: ticker 38s linear infinite; will-change: transform; backface-visibility: hidden; transform: translate3d(0, 0, 0); }
  .review { flex: 0 0 auto; margin-right: 16px; width: 270px; aspect-ratio: 1 / 1; display: flex; flex-direction: column; gap: 10px; padding: 20px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 6px 16px rgba(28, 36, 64, .06); }
  .zaleta { justify-content: center; gap: 12px; }
  .zaleta .ikona { width: 58px; height: 58px; border-radius: 18px; background: var(--peach); display: grid; place-items: center; font-size: 30px; }
  .zaleta b { font-family: var(--display); font-weight: 600; font-size: 21px; color: var(--ink); }
  .zaleta p { font-size: 15px; line-height: 1.5; color: var(--muted); }
  .review { -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; cursor: pointer; transition: border-color .2s, box-shadow .2s; }
  .review:hover, .review:active { border-color: var(--coral); box-shadow: 0 0 0 1px var(--coral), 0 10px 24px rgba(255, 106, 61, .18); }
  .marquee.stop .marquee-track { animation-play-state: paused; }
  @media (hover: hover) and (pointer: fine) { .marquee:hover .marquee-track { animation-play-state: paused; } }
  .review { aspect-ratio: auto; width: 300px; height: 256px; }
  .review blockquote { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .review .avatar-foto { flex: 0 0 44px; width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .review .avatar-wzor { flex: 0 0 52px; width: 52px; height: 52px; border-radius: 50%; object-fit: cover; background: var(--peach); border: 2px solid #fff; box-shadow: 0 0 0 2px var(--peach); }
  .review .avatar { flex: 0 0 44px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-family: var(--display); font-weight: 700; font-size: 20px; }
  .review .ok { font-style: normal; color: var(--green); }
  .review .tytul { font-size: 16px; font-weight: 800; color: var(--ink); line-height: 1.3; }
  .sec-head .zrodlo { font-size: 13.5px; }
  .review .who { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--muted); line-height: 1.3; }
  .review .who img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .review .who b { display: block; color: var(--ink); font-size: 15px; }
  .review .stars { color: var(--star); letter-spacing: 2px; font-size: 17px; }
  .review blockquote { margin: 0; font-size: 15px; line-height: 1.5; color: var(--text); flex: none; height: calc(1.5em * 4); }
  .review .who { margin-top: auto; }
  .sample { align-self: flex-start; font-size: 10.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: var(--red); background: #fde8e8; padding: 3px 8px; border-radius: 6px; }

  /* ---------- CTA ---------- */
  .cta { display: grid; grid-template-columns: 1fr 1fr; gap: 0; overflow: hidden; }
  .cta img { width: 100%; height: 100%; object-fit: cover; min-height: 320px; }
  .cta div { padding: 40px 36px; display: flex; flex-direction: column; justify-content: center; gap: 14px; }
  .cta h2 { font-size: clamp(26px, 3.2vw, 34px); }
  .cta p { color: var(--muted); }

  /* ---------- FAQ ---------- */
  .faq { display: grid; grid-template-columns: 1fr; gap: 28px; max-width: 820px; }
  .faq-head { text-align: center; }
  .faq h2 { font-size: clamp(26px, 3.4vw, 36px); }
  .faq .lead { color: var(--muted); margin-top: 10px; font-size: 15.5px; }
  .faq .lead b { color: var(--ink); word-break: break-all; user-select: all; }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 2px; font-weight: 800; color: var(--ink); font-size: 16px; cursor: pointer; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: "+"; flex: 0 0 auto; font-size: 24px; font-weight: 400; color: var(--coral); transition: transform .2s; }
  .faq-list details[open] summary::after { transform: rotate(45deg); }
  .faq-list details p { padding: 0 2px 18px; color: var(--muted); font-size: 15.5px; }

  /* ---------- stopka ---------- */
  footer.site { background: var(--cream); color: var(--muted); border-top: 1px solid var(--line); padding-block: 48px 28px; font-size: 15px; }
  footer.site .wrap { display: grid; grid-template-columns: 1.3fr 1fr; gap: 36px; }
  footer.site .logo { font-size: 28px; }
  .f-brand p { margin: 12px 0 18px; max-width: 360px; line-height: 1.6; }
