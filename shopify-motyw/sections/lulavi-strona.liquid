<script>
  // wysuwany koszyk: postęp rabatu, zmiana ilości, dobranie kolejnej opaski
  (function () {
    var kosz = document.getElementById('kosz');
    var body = document.getElementById('kosz-body');
    var foot = document.getElementById('kosz-foot');
    var ikona = document.querySelector('.cart');
    var licznik = document.createElement('span');
    licznik.className = 'cart-count';
    licznik.hidden = true;
    if (ikona) ikona.appendChild(licznik);

    function zl(gr) { return (gr / 100).toFixed(2).replace('.', ',') + ' zł'; }
    function rabatZestawu(szt) { return szt >= 3 ? 11998 : szt === 2 ? 4999 : 0; }

    function otworz() { document.body.classList.add('kosz-otwarty'); kosz.setAttribute('aria-hidden', 'false'); }
    function zamknij() { document.body.classList.remove('kosz-otwarty'); kosz.setAttribute('aria-hidden', 'true'); }
    document.getElementById('kosz-x').addEventListener('click', zamknij);
    document.getElementById('kosz-tlo').addEventListener('click', zamknij);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') zamknij(); });
    if (ikona) ikona.addEventListener('click', function (e) { e.preventDefault(); otworz(); pokaz(); });

    function api(url, dane) {
      return fetch(url, dane ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(dane) } : {})
        .then(function (r) { if (!r.ok) throw r; return r.json(); });
    }

    function postep(szt) {
      var tekst = szt >= 3 ? '🎉 Masz <b>najlepszą cenę</b>: oszczędzasz 120 zł!'
        : szt === 2 ? '🎉 Rabat <b>−50 zł</b> odblokowany! Dodaj 3. opaskę i oszczędź <b>120 zł</b>'
        : '🚚 Darmowa dostawa odblokowana! Dodaj 2. opaskę i oszczędź <b>50 zł</b>';
      var pr = Math.min(szt, 3) / 3 * 100;
      return '<div class="postep"><p>' + tekst + '</p><div class="pasek"><i style="width:' + pr + '%"></i></div>' +
        '<div class="etapy"><span class="' + (szt >= 1 ? 'ok' : '') + '">✓ Darmowa dostawa</span>' +
        '<span class="' + (szt >= 2 ? 'ok' : '') + '">' + (szt >= 2 ? '✓ ' : '') + '−50 zł</span>' +
        '<span class="' + (szt >= 3 ? 'ok' : '') + '">' + (szt >= 3 ? '✓ ' : '') + '−120 zł</span></div></div>';
    }

    function upsell(szt) {
      if (szt < 1 || szt >= 3) return '';
      var ile = szt === 1 ? 'Dobierz drugą opaskę za <span>100 zł</span> (zamiast 149,99 zł)' : 'Dobierz trzecią opaskę za <span>80 zł</span> (zamiast 149,99 zł)';
      return '<div class="upsell"><p>➕ ' + ile + ', np. dla rodzeństwa:</p><div class="swatches">' +
        WZORY.map(function (w) {
          return '<button class="swatch" type="button" data-dobierz="' + w.vid + '" title="' + w.nazwa + '" aria-label="Dodaj ' + w.nazwa + '"><img src="' + w.img + '" alt=""></button>';
        }).join('') + '</div></div>';
    }

    function pokaz() {
      return api('/cart.js').then(function (c) {
        var szt = c.item_count;
        licznik.textContent = szt;
        licznik.hidden = !szt;
        if (!szt) {
          body.innerHTML = '<div class="pusty">Twój koszyk jest pusty.<br>Wybierz swojego zwierzaka 🦊🐼🐸</div>';
          foot.innerHTML = '<button class="btn" type="button" id="kosz-wroc">Wybierz opaskę</button>';
          document.getElementById('kosz-wroc').onclick = function () { zamknij(); document.getElementById('kup').scrollIntoView({ behavior: 'smooth' }); };
          return;
        }
        body.innerHTML = postep(szt) + c.items.map(function (it) {
          return '<div class="poz"><img src="' + (it.image || '') + '" alt="">' +
            '<div><b>Lulavi – ' + (it.variant_title || it.product_title) + '</b><small>Opaska ze słuchawkami</small><br>' +
            '<span class="ilosc"><button type="button" data-zmien="' + it.key + '" data-ile="' + (it.quantity - 1) + '" aria-label="Mniej">−</button><span>' + it.quantity + '</span>' +
            '<button type="button" data-zmien="' + it.key + '" data-ile="' + (it.quantity + 1) + '" aria-label="Więcej">+</button></span></div>' +
            '<div class="poz-cena">' + zl(it.original_line_price) + '<br><button class="usun" type="button" data-zmien="' + it.key + '" data-ile="0">Usuń</button></div></div>';
        }).join('') + upsell(szt);
        var rabat = c.total_discount || rabatZestawu(szt);
        var razem = c.original_total_price - rabat;
        foot.innerHTML = '<div class="linia"><span>Suma</span><span>' + zl(c.original_total_price) + '</span></div>' +
          (rabat ? '<div class="linia rabat"><span>Rabat za zestaw</span><span>−' + zl(rabat) + '</span></div>' : '') +
          '<div class="linia rabat"><span>Dostawa</span><span>GRATIS</span></div>' +
          '<div class="linia razem"><span>Razem</span><span>' + zl(razem) + '</span></div>' +
          '<a class="btn" href="/checkout">Przejdź do kasy · ' + zl(razem) + '</a>' +
          '<p class="under-btn">🔒 Bezpieczne płatności · BLIK, karta · 14 dni na zwrot</p>';
      });
    }

    body.addEventListener('click', function (e) {
      var z = e.target.closest('[data-zmien]');
      var d = e.target.closest('[data-dobierz]');
      if (z) api('/cart/change.js', { id: z.dataset.zmien, quantity: +z.dataset.ile }).then(pokaz);
      if (d) api('/cart/add.js', { items: [{ id: +d.dataset.dobierz, quantity: 1 }] }).then(pokaz);
    });

    // „Dodaj do koszyka”: wybrane wzory trafiają do koszyka, a koszyk się wysuwa
    cta.addEventListener('click', function () {
      var wybrany = document.querySelector('input[name="pakiet"]:checked');
      var ilosci = {};
      wybrany.closest('.offer').querySelectorAll('.swatches').forEach(function (g) {
        var s = g.querySelector('.swatch[aria-checked="true"]');
        if (s) ilosci[s.dataset.vid] = (ilosci[s.dataset.vid] || 0) + 1;
      });
      var items = Object.keys(ilosci).map(function (id) { return { id: +id, quantity: ilosci[id] }; });
      var tekst = cta.textContent;
      cta.disabled = true;
      cta.textContent = 'Dodaję do koszyka…';
      api('/cart/add.js', { items: items })
        .then(pokaz)
        .then(otworz)
        .catch(function () { alert('Nie udało się dodać do koszyka. Spróbuj jeszcze raz.'); })
        .then(function () { cta.disabled = false; cta.textContent = tekst; });
    });

    pokaz();
  })();
</script>


