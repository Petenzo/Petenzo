<script>
  function obraz(p) { return (window.OBRAZY && window.OBRAZY[p]) || p; }
  var WZORY = [{% for v in product.variants %}
    { vid: {{ v.id }}, nazwa: {{ v.title | json }}, img: {{ v.featured_image | image_url: width: 200 | json }}, ok: {{ v.available | json }} }{% unless forloop.last %},{% endunless %}{% endfor %}
  ];
  // karuzela zdjęć: przesuwanie palcem, kropki i strzałki
  var slider = document.getElementById('slider');
  var slajdy = slider.querySelectorAll('.slide');
  var kropki = document.getElementById('dots');
  slajdy.forEach(function (sl, i) {
    var d = document.createElement('button');
    d.type = 'button';
    d.setAttribute('aria-label', 'Zdjęcie ' + (i + 1));
    d.addEventListener('click', function () { idz(i); });
    kropki.appendChild(d);
  });
  function aktualny() { return Math.round(slider.scrollLeft / slider.clientWidth); }
  function idz(i) { i = (i + slajdy.length) % slajdy.length; slider.scrollTo({ left: i * slider.clientWidth, behavior: 'smooth' }); }
  function zaznacz() { var a = aktualny(); document.querySelectorAll('#dots button, .thumb').forEach(function (d) { var i = d.classList.contains('thumb') ? +d.dataset.i : [].indexOf.call(kropki.children, d); d.setAttribute('aria-current', i === a ? 'true' : 'false'); }); }
  document.querySelectorAll('.thumb').forEach(function (t) { t.addEventListener('click', function () { idz(+t.dataset.i); }); });
  slider.addEventListener('scroll', function () { window.requestAnimationFrame(zaznacz); });
  document.querySelector('.arrow.prev').addEventListener('click', function () { idz(aktualny() - 1); });
  document.querySelector('.arrow.next').addEventListener('click', function () { idz(aktualny() + 1); });
  slider.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') idz(aktualny() + 1); if (e.key === 'ArrowLeft') idz(aktualny() - 1); });
  zaznacz();

  // wybór zestawu i wzorów na zdjęciach
  var cta = document.getElementById('cta-koszyk');
  document.querySelectorAll('.picks').forEach(function (box) {
    var n = +box.dataset.count;
    for (var i = 1; i <= n; i++) {
      (function (i) {
        var wrap = document.createElement('div');
        var label = document.createElement('div');
        label.className = 'pick-label';
        var grid = document.createElement('div');
        grid.className = 'swatches';
        grid.setAttribute('role', 'radiogroup');
        grid.setAttribute('aria-label', 'Wzór opaski nr ' + i);
        var start = (i - 1) % WZORY.length;
        WZORY.forEach(function (w, k) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'swatch';
          b.setAttribute('role', 'radio');
          b.setAttribute('aria-checked', k === start ? 'true' : 'false');
          b.setAttribute('aria-label', w.nazwa);
          b.dataset.vid = w.vid;
          b.title = w.nazwa;
          b.innerHTML = '<img src="' + w.img + '" alt="">';
          b.addEventListener('click', function (e) {
            e.preventDefault();
            grid.querySelectorAll('.swatch').forEach(function (s) { s.setAttribute('aria-checked', 'false'); });
            b.setAttribute('aria-checked', 'true');
            label.innerHTML = (n > 1 ? 'Opaska ' + i + ': ' : 'Wzór: ') + '<span>' + w.nazwa + '</span>';
          });
          grid.appendChild(b);
        });
        label.innerHTML = (n > 1 ? 'Opaska ' + i + ': ' : 'Wzór: ') + '<span>' + WZORY[start].nazwa + '</span>';
        wrap.appendChild(label);
        wrap.appendChild(grid);
        box.appendChild(wrap);
      })(i);
    }
  });
  function odswiez() {
    var wybrany = document.querySelector('input[name="pakiet"]:checked');
    document.querySelectorAll('.offer').forEach(function (o) { o.classList.toggle('on', o.contains(wybrany)); });
    cta.textContent = 'Dodaj do koszyka: ' + wybrany.dataset.price + ' zł';
  }
  document.querySelectorAll('input[name="pakiet"]').forEach(function (r) { r.addEventListener('change', odswiez); });
  odswiez();

  // dodanie wybranych wzorów do koszyka Shopify i przejście do kasy
  cta.addEventListener('click', function () {
    var wybrany = document.querySelector('input[name="pakiet"]:checked');
    var oferta = wybrany.closest('.offer');
    var ilosci = {};
    oferta.querySelectorAll('.swatches').forEach(function (g) {
      var s = g.querySelector('.swatch[aria-checked="true"]');
      if (s) ilosci[s.dataset.vid] = (ilosci[s.dataset.vid] || 0) + 1;
    });
    var items = Object.keys(ilosci).map(function (id) { return { id: +id, quantity: ilosci[id] }; });
    var tekst = cta.textContent;
    cta.disabled = true;
    cta.textContent = 'Dodaję do koszyka…';
    fetch('/cart/clear.js', { method: 'POST' })
      .then(function () {
        return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) });
      })
      .then(function (r) { if (!r.ok) throw r; window.location.href = '/checkout'; })
      .catch(function () { cta.disabled = false; cta.textContent = tekst; alert('Nie udało się dodać do koszyka. Spróbuj jeszcze raz.'); });
  });

  // zakładki „W paczce”
  document.querySelectorAll('.tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      document.querySelectorAll('.tab').forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
    });
  });
</script>

